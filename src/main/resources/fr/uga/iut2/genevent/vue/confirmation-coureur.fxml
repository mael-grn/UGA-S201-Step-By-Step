<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1">
   <content>
      <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="404.0" prefWidth="680.0" stylesheets="@style.css">
         <children>
            <Label fx:id="titreConfirmeCoureur" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" style="-fx-font-weight: bold;" text="Confirme l'inscription du coureur " textAlignment="CENTER" wrapText="true">
               <font>
                  <Font size="40.0" />
               </font>
            </Label>
            <Label fx:id="texteConfirmeCoureur" alignment="CENTER" contentDisplay="CENTER" prefHeight="74.0" prefWidth="549.0" text="Le coureur sera inscrit a la course pour le montant fixé" wrapText="true">
               <font>
                  <Font size="26.0" />
               </font>
               <VBox.margin>
                  <Insets left="15.0" right="15.0" top="50.0" />
               </VBox.margin>
            </Label>
            <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
               <children>
                  <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#annulerInscrireButton" prefHeight="30.0" styleClass="button-white" text="Annuler">
                     <HBox.margin>
                        <Insets right="20.0" top="35.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="confirmerCoureur" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#confirmeCoureurAction" prefHeight="30.0" styleClass="button-green" text="Confirmer" textFill="WHITE">
                     <HBox.margin>
                        <Insets left="20.0" top="35.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="50.0" />
               </VBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
