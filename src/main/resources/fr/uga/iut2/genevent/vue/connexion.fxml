<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="labelTitleConnexion" alignment="CENTER" text="Connexion">
         <font>
            <Font name="System Bold" size="38.0" />
         </font>
      </Label>
      <VBox fx:id="vboxListeOrganisateurs" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: #e1e8cc;">
         <children>
            <Label fx:id="labelTitre" alignment="CENTER" contentDisplay="CENTER" prefWidth="350.0" style="-fx-background-color: #bdcc94;" text="Se connecter avec un profil existant">
               <font>
                  <Font size="16.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
               </padding>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </Label>
         </children>
         <VBox.margin>
            <Insets left="20.0" right="20.0" top="15.0" />
         </VBox.margin></VBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="buttonRetour" mnemonicParsing="false" onAction="#exitMenuItemAction" text="Quitter">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
               <styleClass>
                  <String fx:value="button-white" />
                  <String fx:value="button" />
               </styleClass>
            </Button>
            <Button fx:id="buttonAjouterConnexion" mnemonicParsing="false" onAction="#creerOrganisateurActionButton" text="Créer un organisateur" textFill="WHITE">
               <styleClass>
                  <String fx:value="button" />
                  <String fx:value="button-green" />
               </styleClass>
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
