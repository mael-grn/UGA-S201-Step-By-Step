                <Label text="distance :" GridPane.rowIndex="3" />
                <TextField fx:id="tfDistanceCourse" onInputMethodTextChanged="#validateTextFieldsCourse" onKeyPressed="#validateTextFieldsCourse" onKeyReleased="#validateTextFieldsCourse" onKeyTyped="#validateTextFieldsCourse" promptText="ex : 42,195" styleClass="tf" GridPane.columnIndex="1" GridPane.rowIndex="3">
