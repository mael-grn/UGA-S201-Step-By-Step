<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="640.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Ajouter un parking">
         <padding>
            <Insets bottom="50.0" />
         </padding>
      </Label>
      <GridPane alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="550.0" style="-fx-background-color: #e1e8cc;">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nom* :" />
            <TextField fx:id="nomParking" onInputMethodTextChanged="#validateParkingEvent" onKeyPressed="#validateParkingEvent" onKeyReleased="#validateParkingEvent" onKeyTyped="#validateParkingEvent" promptText="Parking1" styleClass="tf" GridPane.columnIndex="1">
               <GridPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </GridPane.margin>
            </TextField>
            <Label text="Coordonées :" GridPane.rowIndex="1" />
            <TextField fx:id="adresseParking" onInputMethodTextChanged="#validateParkingEvent" onKeyPressed="#validateParkingEvent" onKeyReleased="#validateParkingEvent" onKeyTyped="#validateParkingEvent" promptText="41.40338, 2.17403" styleClass="tf" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <GridPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </GridPane.margin>
            </TextField>
            <Label text="Nombre de places* :" GridPane.rowIndex="2" />
            <TextField fx:id="nbPlaceParking" onInputMethodTextChanged="#validateParkingEvent" onKeyPressed="#validateParkingEvent" onKeyReleased="#validateParkingEvent" onKeyTyped="#validateParkingEvent" promptText="54" styleClass="tf" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <GridPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </GridPane.margin>
            </TextField>
         </children>
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
      </GridPane>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
         <children>
            <Button fx:id="BoutonAnnuler" mnemonicParsing="false" onAction="#BoutonAnnuler" text="Annuler">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
               <styleClass>
                  <String fx:value="button" />
                  <String fx:value="button-white" />
               </styleClass>
            </Button>
            <Button fx:id="buttonCreerParking" mnemonicParsing="false" onAction="#ajouterParking" stylesheets="@style.css" text="Ajouter" textFill="WHITE">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
               <styleClass>
                  <String fx:value="button-green" />
                  <String fx:value="button" />
               </styleClass>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
