<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label style="-fx-font-size: 38; -fx-font-weight: bold;" text="Vos événements">
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin></Label>
      <VBox fx:id="vboxEvents" alignment="CENTER" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #d6d6d6;">
         <children>
            <Label style="-fx-font-size: 16; -fx-background-color: #bdcc94;" text="Sélectionner un événement">
               <padding>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="25.0" left="75.0" right="75.0" top="25.0" />
         </VBox.margin>
      </VBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="buttonRetour" mnemonicParsing="false" text="Retour">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin></Button>
            <Button fx:id="buttonCréer" mnemonicParsing="false" onAction="#creerEvenementAction" text="Créer un événement" HBox.hgrow="NEVER">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin></Button>
         </children>
      </HBox>
   </children>
</VBox>
